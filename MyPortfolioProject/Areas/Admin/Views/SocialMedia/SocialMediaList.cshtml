@model List<SocialMedia>
@{
    ViewData["Title"] = "Sosyal Medya Hesapları";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-0 fw-semibold">Sosyal Medya Bağlantıları</h4>
                <small class="text-muted">Sitenizde görünecek sosyal medya ve iletişim hesaplarınızı yönetin.</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/Contact/ContactList" class="btn btn-outline-secondary rounded-3">İletişim Bilgilerine Dön</a>
                <a href="/Admin/SocialMedia/CreateSocialMedia" class="btn text-white rounded-3" style="background:#2f5d4e;">+ Yeni Hesap Ekle</a>
            </div>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>İkon</th>
                    <th>Platform Adı</th>
                    <th>Bağlantı (URL)</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SocialMediaId</td>
                        <td><i class="@item.IconUrl fs-5"></i></td>
                        <td class="fw-medium">@item.Title</td>
                        <td><a href="@item.Url" target="_blank" class="text-decoration-none">@item.Url</a></td>
                        <td>
                            <a href="/Admin/SocialMedia/UpdateSocialMedia/@item.SocialMediaId" class="btn btn-sm btn-success">Güncelle</a>
                            <a href="/Admin/SocialMedia/DeleteSocialMedia/@item.SocialMediaId" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

