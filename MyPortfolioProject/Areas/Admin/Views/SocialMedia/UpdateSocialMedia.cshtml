@model SocialMedia
@{
    ViewData["Title"] = "Sosyal Medya Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4" style="max-width: 650px;">
        <h4 class="mb-3 fw-semibold">Sosyal Medya Hesabını Güncelle</h4>
        <form method="post">
            <input type="hidden" asp-for="SocialMediaId" />

            <div class="mb-3">
                <label class="form-label">Platform Adı</label>
                <input asp-for="Title" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Profil Bağlantısı (URL)</label>
                <input asp-for="Url" class="form-control" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Bootstrap İkon Class</label>
                <input asp-for="IconUrl" class="form-control" required />
            </div>

            <button type="submit" class="btn text-white px-4" style="background:#2f5d4e;">Güncelle</button>
            <a href="/Admin/SocialMedia/SocialMediaList" class="btn btn-light border">Vazgeç</a>
        </form>
    </div>
</div>

