@model SkillItem
@{
    ViewData["Title"] = "Yetenek Güncelle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4" style="max-width: 600px;">
        <h4 class="mb-3 fw-semibold">Yetenek Güncelle</h4>
        <form method="post">
            <input type="hidden" asp-for="SkillItemId" />
            <div class="mb-3">
                <label class="form-label">Bağlı Olduğu Kategori</label>
                <select asp-for="SkillId" asp-items="ViewBag.Skills" class="form-select" required></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Yetenek Adı</label>
                <input asp-for="SkillItemTitle" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Seviye (0 - 100 Arası)</label>
                <input asp-for="Rate" type="number" min="0" max="100" class="form-control" required />
            </div>
            <button type="submit" class="btn text-white px-4" style="background:#2f5d4e;">Güncelle</button>
            <a href="/Admin/SkillItem/SkillItemList" class="btn btn-light border">Vazgeç</a>
        </form>
    </div>
</div>

