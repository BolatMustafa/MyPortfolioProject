@model List<SkillItem>
@{
    ViewData["Title"] = "Yetenekler ve Seviyeler";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-0 fw-semibold">Yetenek Listesi ve Seviyeler (0-100)</h4>
                <small class="text-muted">Kategorilere bağlı teknolojileri ve yüzdelik hakimiyet oranlarını yönetin.</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/Skill/SkillList" class="btn btn-outline-secondary rounded-3">Kategorilere Dön</a>
                <a href="/Admin/SkillItem/CreateSkillItem" class="btn text-white rounded-3" style="background:#2f5d4e;">+ Yeni Yetenek Ekle</a>
            </div>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Yetenek Adı</th>
                    <th>Kategori</th>
                    <th style="width: 250px;">Seviye (0-100)</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.SkillItemId</td>
                        <td class="fw-medium">@item.SkillItemTitle</td>
                        <td><span class="badge bg-light text-dark border">@item.Skill?.Title</span></td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div class="progress-bar" style="width: @item.Rate%; background-color: #2f5d4e;"></div>
                                </div>
                                <small class="fw-semibold">%@item.Rate</small>
                            </div>
                        </td>
                        <td>
                            <a href="/Admin/SkillItem/UpdateSkillItem/@item.SkillItemId" class="btn btn-sm btn-success">Güncelle</a>
                            <a href="/Admin/SkillItem/DeleteSkillItem/@item.SkillItemId" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

