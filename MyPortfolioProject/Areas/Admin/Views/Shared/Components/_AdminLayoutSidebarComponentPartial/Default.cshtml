@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}

<aside class="admin-sidebar" id="adminSidebar">
    <!-- Brand Header -->
    <div class="sidebar-header">
        <div class="brand-mark">
            <i class="bi bi-briefcase-fill"></i>
        </div>
        <div class="brand-text">
            <h1>Mustafa Bolat</h1>
            <span>Yönetim Paneli</span>
        </div>
    </div>

    <!-- Menu Links -->
    <div class="sidebar-menu-wrapper">
        <div class="menu-section-label">Menü</div>
        <ul class="sidebar-nav">
            <li>
                <a href="/Admin/Dashboard/Index" class="sidebar-link @(currentPath.Contains("/dashboard") ? "active" : "")">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li>
                <a href="/Admin/HeroSection/Index" class="sidebar-link @(currentPath.Contains("/herosection") ? "active" : "")">
                    <i class="bi bi-window-desktop"></i>
                    <span>Ana Sayfa</span>
                </a>
            </li>
            <li>
                <a href="/Admin/About/Index" class="sidebar-link @(currentPath.Contains("/about") ? "active" : "")">
                    <i class="bi bi-person"></i>
                    <span>Hakkımda</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Skill/SkillList" class="sidebar-link @(currentPath.Contains("/skill") ? "active" : "")">
                    <i class="bi bi-stars"></i>
                    <span>Yeteneklerim</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Experience/ExperienceList" class="sidebar-link @(currentPath.Contains("/experience") ? "active" : "")">
                    <i class="bi bi-journal-bookmark-fill"></i>
                    <span>Deneyimlerim</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Project/ProjectList" class="sidebar-link @(currentPath.Contains("/project") ? "active" : "")">
                    <i class="bi bi-code-slash"></i>
                    <span>Projelerim</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Category/CategoryList" class="sidebar-link @(currentPath.Contains("/category") ? "active" : "")">
                    <i class="bi bi-tags"></i>
                    <span>Kategoriler</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Education/EducationList" class="sidebar-link @(currentPath.Contains("/education") ? "active" : "")">
                    <i class="bi bi-mortarboard"></i>
                    <span>Eğitim</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Contact/ContactList" class="sidebar-link @(currentPath.Contains("/contact") ? "active" : "")">
                    <i class="bi bi-envelope"></i>
                    <span>İletişim</span>
                </a>
            </li>
            <li>
                <a href="/Admin/Message/MessageList" class="sidebar-link @(currentPath.Contains("/message") ? "active" : "")">
                    <i class="bi bi-inbox"></i>
                    <span>Gelen Kutusu</span>
                    <span id="sidebarUnreadBadge" class="badge-count bg-danger text-white" style="display: @(ViewBag.UnreadMessageCount > 0 ? "inline-block" : "none");">@ViewBag.UnreadMessageCount</span>
                </a>
            </li>
        </ul>

        <div class="menu-section-label mt-4">Sistem & Bağlantı</div>
        <ul class="sidebar-nav">
            <li>
                <a href="/Default/Index" target="_blank" class="sidebar-link">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Siteyi Önizle</span>
                </a>
            </li>
        </ul>
    </div>

    <!-- Admin User / Logout Footer -->
    <div class="sidebar-footer">
        <div class="admin-user-card">
            <div class="user-avatar-circle">AK</div>
            <div class="user-info">
                <div class="user-name">Admin Kullanıcı</div>
                <div class="user-role">İçerik Yöneticisi</div>
            </div>
            <a href="/Default/Index" class="btn-logout" title="Vitrine Dön">
                <i class="bi bi-box-arrow-right"></i>
            </a>
        </div>
    </div>
</aside>
