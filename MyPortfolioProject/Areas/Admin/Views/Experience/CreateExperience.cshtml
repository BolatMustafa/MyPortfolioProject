@model Experience
@{
    ViewData["Title"] = "Yeni Deneyim Ekle";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4" style="max-width: 750px;">
        <h4 class="mb-3 fw-semibold">Yeni Deneyim Ekle</h4>
        <form method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Pozisyon / Unvan</label>
                    <input asp-for="Title" class="form-control" placeholder="Örn: Senior .NET Developer" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Şirket / Kurum Adı</label>
                    <input asp-for="CompanyName" class="form-control" placeholder="Örn: ABC Teknoloji" required />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Dönem / Kategori</label>
                <input asp-for="Category" class="form-control" placeholder="Örn: 2022 - Günümüz veya Tam Zamanlı" required />
            </div>

            <div class="mb-3">
                <label class="form-label">Açıklama</label>
                <textarea asp-for="Description" rows="4" class="form-control" placeholder="Görev tanımı ve yaptığınız çalışmalar..." required></textarea>
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="IsActive" class="form-check-input" role="switch" checked />
                <label asp-for="IsActive" class="form-check-label">Aktif (Sitede Görünsün)</label>
            </div>

            <button type="submit" class="btn text-white px-4" style="background:#2f5d4e;">Kaydet</button>
            <a href="/Admin/Experience/ExperienceList" class="btn btn-light border">Vazgeç</a>
        </form>
    </div>
</div>

