@model MyPortfolioProject.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";

    int total = Model.TotalMessages;
    int unread = Model.UnreadMessages;
    int read = Model.ReadMessages;
    int rate = total == 0 ? 0 : read * 100 / total;

    int totalProjects = Model.TotalProjects;
    int activeProjects = Model.ActiveProjects;
    int totalSkills = Model.TotalSkills;
    int totalExperiences = Model.TotalExperiences;
    int totalEducations = Model.TotalEducations;

    var lastMessages = Model.LastMessages;
    var lastProjects = Model.LastProjects;
    var categorySummary = Model.CategorySummary;
    int maxCatCount = categorySummary.Any() ? Math.Max(1, categorySummary.Max(x => x.ProjectCount)) : 1;
}


<style>
    .db {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
        --muted: #8a8a85;
    }

    .db-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.4rem;
        height: 100%;
    }

    .db-title {
        font-weight: 600;
        margin-bottom: 1.2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .db-title small {
            color: var(--muted);
            font-weight: 400;
        }

    .stat {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .stat-val {
        font-size: 1.8rem;
        font-weight: 700;
        line-height: 1;
    }

    .stat-lbl {
        color: var(--muted);
        font-size: .85rem;
        margin-top: .3rem;
    }

    .c-green { background: var(--g-soft); color: var(--g); }
    .c-blue { background: #e6eef8; color: #3b6ea5; }
    .c-rose { background: #f9e7e7; color: #b44b4b; }
    .c-amber { background: #fdf3e1; color: #b67b1f; }
    .c-purple { background: #efeaf8; color: #6b4fa3; }

    .donut {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        margin: .5rem auto 1.2rem;
        display: grid;
        place-items: center;
        background: conic-gradient(var(--g) calc(var(--p) * 1%), var(--g-soft) 0);
    }

        .donut div {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: #fff;
            display: grid;
            place-items: center;
            font-size: 1.5rem;
            font-weight: 700;
        }

    .legend {
        display: flex;
        justify-content: center;
        gap: 1.2rem;
        font-size: .85rem;
        color: var(--muted);
    }

        .legend i {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 3px;
            margin-right: .35rem;
        }

    .msg-row {
        display: flex;
        align-items: center;
        gap: .9rem;
        padding: .85rem 0;
        border-bottom: 1px solid var(--line);
    }

        .msg-row:last-child {
            border-bottom: none;
        }

    .avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-weight: 600;
        flex-shrink: 0;
    }

    .msg-body {
        flex: 1;
        min-width: 0;
    }

        .msg-body p {
            margin: 0;
            color: var(--muted);
            font-size: .85rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .badge-soft {
        font-size: .72rem;
        padding: .3rem .65rem;
        border-radius: 20px;
        font-weight: 500;
    }
</style>

<div class="db container-fluid py-3">

    <!-- Üst Başlık ve Hızlı Erişim Kısayolları -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h4 class="mb-0 fw-semibold">Yönetim Özeti</h4>
            <small class="text-muted">Portfolyo içeriklerinize ve gelen mesajlarınıza ait güncel durum.</small>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Admin/Project/CreateProject" class="btn text-white rounded-3 px-3" style="background:#2f5d4e;">
                <i class="bi bi-plus-circle me-1"></i> Yeni Proje Ekle
            </a>
            <a href="/Admin/Message/MessageList" class="btn btn-outline-secondary rounded-3 px-3 bg-white">
                <i class="bi bi-inbox me-1"></i> Mesajları Gör
                @if (unread > 0)
                {
                    <span class="badge bg-danger ms-1">@unread</span>
                }
            </a>
            <a href="/Admin/Experience/CreateExperience" class="btn btn-outline-secondary rounded-3 px-3 bg-white">
                <i class="bi bi-briefcase me-1"></i> Deneyim Ekle
            </a>
        </div>
    </div>

    <!-- 7 Dinamik İstatistik Kartı -->
    <div class="row g-3 mb-4">
        @{
            var stats = new[] {
                (Val: totalProjects,    Lbl: "Toplam Proje",    Icon: "bi-folder2-open",          Cls: "c-green"),
                (Val: activeProjects,   Lbl: "Aktif Proje",     Icon: "bi-check2-circle",         Cls: "c-blue"),
                (Val: totalSkills,      Lbl: "Yetenek",         Icon: "bi-stars",                 Cls: "c-purple"),
                (Val: totalExperiences, Lbl: "Deneyim",         Icon: "bi-briefcase",             Cls: "c-amber"),
                (Val: totalEducations,  Lbl: "Eğitim",          Icon: "bi-mortarboard",           Cls: "c-green"),
                (Val: total,            Lbl: "Toplam Mesaj",    Icon: "bi-envelope",              Cls: "c-blue"),
                (Val: unread,           Lbl: "Okunmamış Mesaj", Icon: "bi-envelope-exclamation",  Cls: "c-rose")
            };
        }
        @foreach (var s in stats)
        {
            <div class="col-12 col-sm-6 col-md-4 col-xl-3">
                <div class="db-card stat">
                    <div class="stat-icon @s.Cls"><i class="bi @s.Icon"></i></div>
                    <div>
                        <div class="stat-val">@s.Val</div>
                        <div class="stat-lbl">@s.Lbl</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Kategori Özeti & Okunma Oranı -->
    <div class="row g-4 mb-4">
        <div class="col-xl-8">
            <div class="db-card">
                <div class="db-title">
                    Kategori Özeti
                    <small>Kategorilere göre proje dağılımı</small>
                </div>
                @if (!categorySummary.Any())
                {
                    <p class="text-muted small mb-0">Henüz kategori kaydı bulunmuyor.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <tbody>
                                @foreach (var cat in categorySummary)
                                {
                                    var widthPercent = (cat.ProjectCount * 100) / maxCatCount;
                                    <tr>
                                        <td style="width: 32%;" class="fw-medium">@cat.CategoryName</td>
                                        <td>
                                            <div class="progress" style="height: 10px; background-color: var(--g-soft);">
                                                <div class="progress-bar" role="progressbar" style="width: @widthPercent%; background-color: var(--g);" aria-valuenow="@cat.ProjectCount" aria-valuemin="0" aria-valuemax="@maxCatCount"></div>
                                            </div>
                                        </td>
                                        <td style="width: 90px;" class="text-end">
                                            <span class="badge-soft c-green">@cat.ProjectCount Proje</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <div class="col-xl-4">
            <div class="db-card">
                <div class="db-title">Mesaj Okunma Oranı</div>
                <div class="donut" style="--p:@rate"><div>%@rate</div></div>
                <div class="legend">
                    <span><i style="background:var(--g)"></i>Okundu (@read)</span>
                    <span><i style="background:var(--g-soft)"></i>Okunmadı (@unread)</span>
                </div>
            </div>
        </div>
    </div>
    <!-- Son Eklenen 3 Proje & Son 5 Mesaj -->
    <div class="row g-4">
        <div class="col-xl-5">
            <div class="db-card">
                <div class="db-title">
                    Son Eklenen Projeler
                    <a href="/Admin/Project/ProjectList" class="small text-decoration-none" style="color:var(--g)">Tümünü gör →</a>
                </div>
                @foreach (var p in lastProjects)
                {
                    <div class="msg-row">
                        <div class="avatar" style="border-radius:10px;"><i class="bi bi-code-slash"></i></div>
                        <div class="msg-body">
                            <strong>@p.ProjectTitle</strong>
                            <p>@(p.Category?.CategoryName ?? "Kategorisiz")</p>
                        </div>
                        <span class="badge-soft @(p.IsActive ? "c-green" : "c-rose")">@(p.IsActive ? "Aktif" : "Pasif")</span>
                    </div>
                }
            </div>
        </div>

        <div class="col-xl-7">
            <div class="db-card">
                <div class="db-title">
                    Son 5 Mesaj
                    <a href="/Admin/Message/MessageList" class="small text-decoration-none" style="color:var(--g)">Gelen Kutusuna Git →</a>
                </div>
                @foreach (var m in lastMessages)
                {
                    var initial = string.IsNullOrEmpty(m.SenderName) ? "?" : m.SenderName.Substring(0, 1).ToUpper();
                    <div class="msg-row">
                        <div class="avatar">@initial</div>
                        <div class="msg-body">
                            <strong>@m.SenderName</strong> · <span class="small">@m.Subject</span>
                            <p>@m.MessageDetail</p>
                        </div>
                        <small class="text-muted d-none d-md-block">@m.SendDate.ToString("dd.MM.yyyy HH:mm")</small>
                        <span id="db-msg-badge-@m.MessageId">
                            <span class="badge-soft @(m.IsRead ? "c-blue" : "c-rose")">@(m.IsRead ? "Okundu" : "Okunmadı")</span>
                        </span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="openDashboardMessage(@m.MessageId)">Oku</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="dashboardMessageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom">
                <h5 class="modal-title fw-semibold" id="dbModalSubject">Mesaj Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2"><small class="text-muted d-block">Gönderen</small><strong id="dbModalSenderName"></strong> (<span id="dbModalSenderEmail" class="text-muted"></span>)</div>
                <div class="mb-3"><small class="text-muted d-block">Tarih</small><span id="dbModalSendDate"></span></div>
                <div class="p-3 bg-light rounded-3 border"><p id="dbModalMessageDetail" class="mb-0" style="white-space: pre-wrap;"></p></div>
            </div>
            <div class="modal-footer border-top">
                <a href="/Admin/Message/MessageList" class="btn btn-outline-secondary">Gelen Kutusuna Git</a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openDashboardMessage(id) {
        fetch('/Admin/Message/GetMessageDetail/' + id)
            .then(function (r) { return r.json(); })
            .then(function (d) {
                document.getElementById('dbModalSubject').innerText = d.subject;
                document.getElementById('dbModalSenderName').innerText = d.senderName;
                document.getElementById('dbModalSenderEmail').innerText = d.senderEmail;
                document.getElementById('dbModalSendDate').innerText = d.sendDate;
                document.getElementById('dbModalMessageDetail').innerText = d.messageDetail;
                var b = document.getElementById('db-msg-badge-' + id);
                if (b) b.innerHTML = '<span class="badge-soft c-blue">Okundu</span>';
                var sb = document.getElementById('sidebarUnreadBadge');
                if (sb && d.unreadCount !== undefined) {
                    sb.innerText = d.unreadCount;
                    sb.style.display = d.unreadCount > 0 ? 'inline-block' : 'none';
                }
                new bootstrap.Modal(document.getElementById('dashboardMessageModal')).show();
            });
    }
</script>

    
