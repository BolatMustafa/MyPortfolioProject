@model List<Education>
@{
    ViewData["Title"] = "Eğitim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-0 fw-semibold">Eğitim Hayatım Listesi</h4>
                <small class="text-muted">Ana sayfada yer alacak akademik eğitim bilgilerinizi yönetin.</small>
            </div>
            <a href="/Admin/Education/CreateEducation" class="btn text-white rounded-3" style="background:#2f5d4e;">+ Yeni Eğitim Ekle</a>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Bölüm / Derece</th>
                    <th>Okul / Kurum</th>
                    <th>Dönem / Rozet</th>
                    <th>Açıklama</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.EducationId</td>
                        <td class="fw-medium">@item.Title</td>
                        <td>@item.SchoolName</td>
                        <td><span class="badge bg-light text-dark border">@item.PeriodOrBadge</span></td>
                        <td>@item.Description</td>
                        <td>
                            <a href="/Admin/Education/UpdateEducation/@item.EducationId" class="btn btn-sm btn-success">Güncelle</a>
                            <a href="/Admin/Education/DeleteEducation/@item.EducationId" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

