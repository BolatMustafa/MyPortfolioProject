@model List<Contact>
@{
    ViewData["Title"] = "İletişim Bilgileri";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="container-fluid py-3">
    <div class="bg-white border rounded-4 p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="mb-0 fw-semibold">İletişim Bilgileri</h4>
                <small class="text-muted">Ana sayfanızdaki iletişim bölümü ve sosyal medya bağlantılarınızı yönetin.</small>
            </div>
            <div class="d-flex gap-2">
                <a href="/Admin/SocialMedia/SocialMediaList" class="btn btn-outline-secondary rounded-3">Sosyal Medya Bağlantıları</a>
                <a href="/Admin/Contact/CreateContact" class="btn text-white rounded-3" style="background:#2f5d4e;">+ Yeni İletişim Bilgisi Ekle</a>
            </div>
        </div>

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Başlık</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>Konum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ContactId</td>
                        <td>
                            <div class="fw-medium">@item.Title</div>
                            <small class="text-muted">@item.Description</small>
                        </td>
                        <td>@item.Email</td>
                        <td>@item.PhoneNumber</td>
                        <td>@item.Location</td>
                        <td>
                            <a href="/Admin/Contact/UpdateContact/@item.ContactId" class="btn btn-sm btn-success">Güncelle</a>
                            <a href="/Admin/Contact/DeleteContact/@item.ContactId" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
