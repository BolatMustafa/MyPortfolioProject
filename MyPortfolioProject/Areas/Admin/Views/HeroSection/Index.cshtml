@model HeroSection
@{
    ViewData["Title"] = "Ana Sayfa Yönetimi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<style>
    .um {
        --g: #2f5d4e;
        --g-soft: #e7efe9;
        --line: #ebe8e1;
    }

    .um-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 1.75rem;
        height: 100%;
    }

    .um-head {
        display: flex;
        align-items: center;
        gap: .9rem;
        margin-bottom: 1.5rem;
    }

    .um-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--g-soft);
        color: var(--g);
        display: grid;
        place-items: center;
        font-size: 1.3rem;
    }

    .um-head h4 {
        margin: 0;
        font-weight: 600;
    }

    .um-head small {
        color: #8a8a85;
    }

    .um .form-label {
        font-size: .85rem;
        font-weight: 500;
        color: #6b6b66;
        margin-bottom: .4rem;
    }

    .um .form-control {
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: .7rem .9rem;
        background: #fcfbf9;
    }

        .um .form-control:focus {
            border-color: var(--g);
            background: #fff;
            box-shadow: 0 0 0 .2rem rgba(47,93,78,.12);
        }

    .um-btn {
        background: var(--g);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: .75rem;
        font-weight: 500;
    }

        .um-btn:hover {
            background: #244a3e;
            color: #fff;
        }
</style>

<div class="um container-fluid py-3">
    <form method="post">
        <input type="hidden" asp-for="HeroSectionId" />
        <div class="row g-4">
            <div class="col-xl-8 col-lg-7">
                <div class="um-card">
                    <div class="um-head">
                        <div class="um-icon"><i class="bi bi-window-desktop"></i></div>
                        <div>
                            <h4>Ana Sayfa (Hero) Bilgilerini Güncelle</h4>
                            <small>Sitenin giriş bölümünde görünen karşılama ve tanıtım metinlerini düzenleyin.</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Greeting" class="form-label">Karşılama Metni (Rozet)</label>
                        <input asp-for="Greeting" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Ana Başlık / Unvan</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Kısa Açıklama</label>
                        <textarea asp-for="Description" rows="4" class="form-control" required></textarea>
                    </div>
                </div>
            </div>

            <div class="col-xl-4 col-lg-5">
                <div class="um-card d-flex flex-column">
                    <div class="mb-3">
                        <label asp-for="MainImageUrl" class="form-label">Profil / Kapak Fotoğraf URL</label>
                        <input asp-for="MainImageUrl" class="form-control" required />
                    </div>

                    @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                    {
                        <div class="text-center my-2">
                            <img src="@Model.MainImageUrl" alt="Önizleme" class="img-fluid rounded-3 border" style="max-height: 220px; object-fit: cover;" />
                        </div>
                    }

                    <div class="mt-auto pt-4 d-grid">
                        <button type="submit" class="um-btn">Değişiklikleri Kaydet</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

