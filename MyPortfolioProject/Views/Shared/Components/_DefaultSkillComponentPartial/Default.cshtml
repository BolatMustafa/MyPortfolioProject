@model List<Skill>

<section id="skills">
    <div class="container">
        <div class="section-header text-center mx-auto reveal-on-scroll" style="max-width: 680px;">
            <div class="eyebrow-badge">
                <i class="bi bi-stack"></i> TEKNOLOJİ YIĞINIM
            </div>
            <h2 class="section-title">
                Kullandığım Teknolojiler ve Uzmanlık Alanlarım
            </h2>
            <p class="section-description mx-auto">
                Bir fikrin hayata geçirilmesinden ölçeklenebilir bir yazılım ürününe dönüşmesine kadar farklı teknolojilerle çalışıyorum.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 reveal-on-scroll">
                    <div class="skill-card h-100">
                        <div class="skill-icon-box">
                            <i class="@item.IconUrl"></i>
                        </div>
                        <h3 class="h5 fw-bold mb-3">@item.Title</h3>
                        <p class="text-muted small mb-4">@item.Description</p>

                        @if (item.SkillItems != null && item.SkillItems.Any())
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var skill in item.SkillItems)
                                {
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="small fw-semibold">@skill.SkillItemTitle</span>
                                            <span class="small text-muted fw-medium">%@skill.Rate</span>
                                        </div>
                                        <div class="progress" style="height: 6px; background-color: #ebe8e1;">
                                            <div class="progress-bar" role="progressbar" style="width: @skill.Rate%; background-color: #2f5d4e;" aria-valuenow="@skill.Rate" aria-valuemin="0" aria-valuemax="100"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

