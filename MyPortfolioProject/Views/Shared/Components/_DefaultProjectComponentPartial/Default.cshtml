@model List<Project>

<section id="projects">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 gap-3 reveal-on-scroll">
            <div>
                <div class="eyebrow-badge">
                    <i class="bi bi-folder-check"></i> SEÇİLMİŞ ÇALIŞMALAR
                </div>
                <h2 class="section-title mb-1">
                    Fikirden Ürüne Dönüşen Projeler
                </h2>
                <p class="section-description mb-0">
                    Öğrenme, üretme ve problem çözme süreçlerimin birer yansıması olan projelerimden bazıları.
                </p>
            </div>

            <!-- Filter Buttons -->
            <div class="d-flex flex-wrap gap-2" id="projectFilters">
                <button class="filter-btn active" data-filter="all">Tümü</button>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories)
                    {
                        <button class="filter-btn" data-filter="cat-@cat.CategoryId">@cat.CategoryName</button>
                    }
                }
            </div>
        </div>

        <!-- Project Grid -->
        <div class="row g-4" id="projectGrid">
            @foreach (var item in Model)
            {
                <div class="col-lg-6 project-item reveal-on-scroll" data-category="cat-@item.CategoryId">
                    <div class="project-card">
                        <div class="project-thumb-wrap">
                            <img src="@item.ImageUrl" alt="@item.ProjectTitle" class="project-thumb-img">
                            <span class="project-category-tag">@item.Category?.CategoryName</span>
                        </div>
                        <div class="project-body">
                            <h3 class="h4 fw-bold mb-2">@item.ProjectTitle</h3>
                            <p class="text-muted small mb-4 flex-grow-1">
                                @item.Description
                            </p>
                            <div class="mb-4">
                                @if (!string.IsNullOrEmpty(item.Technologies))
                                {
                                    foreach (var tech in item.Technologies.Split(','))
                                    {
                                        <span class="tech-badge">@tech.Trim()</span>
                                    }
                                }
                            </div>
                            <div class="d-flex align-items-center justify-content-between pt-3 border-top">
                                <a href="#contact" class="btn-sage btn-sm">
                                    <span>Projeyi İncele</span>
                                    <i class="bi bi-arrow-up-right"></i>
                                </a>
                                <span class="text-muted small"><i class="bi bi-folder2-open me-1"></i>@item.Category?.CategoryName</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

