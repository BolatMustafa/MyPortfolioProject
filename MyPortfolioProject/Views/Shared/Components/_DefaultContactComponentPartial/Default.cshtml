@model Contact

<section id="contact">
    <div class="container">
        <div class="row gy-5">
            <!-- Left Column: Contact Info -->
            <div class="col-lg-5 reveal-on-scroll">
                <div class="eyebrow-badge">
                    <i class="bi bi-envelope-paper-fill"></i> İLETİŞİME GEÇELİM
                </div>
                <h2 class="section-title">
                    @(Model?.Title ?? "Harika Bir Fikrin mi Var? Birlikte Hayata Geçirelim.")
                </h2>
                <p class="text-muted mb-4 fs-6">
                    @(Model?.Description ?? "Yeni projeler, eğitimler, iş birlikleri veya yalnızca teknoloji üzerine sohbet etmek için benimle iletişime geçebilirsin.")
                </p>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                        <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <div class="text-muted small">E-posta</div>
                            <div class="fw-semibold">@(Model?.Email ?? "ornek@email.com")</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model?.PhoneNumber))
                    {
                        <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                            <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);">
                                <i class="bi bi-telephone"></i>
                            </div>
                            <div>
                                <div class="text-muted small">Telefon</div>
                                <div class="fw-semibold">@Model.PhoneNumber</div>
                            </div>
                        </div>
                    }

                    <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                        <div class="skill-icon-box mb-0" style="width: 44px; height: 44px; background: var(--bg-secondary);">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <div class="text-muted small">Konum</div>
                            <div class="fw-semibold">@(Model?.Location ?? "İstanbul, Türkiye")</div>
                        </div>
                    </div>
                </div>

                <!-- Social links -->
                <div class="pt-2">
                    <div class="text-muted small font-heading fw-semibold mb-2">Sosyal Ağlar:</div>
                    <div class="d-flex gap-2">
                        @if (ViewBag.SocialMedias != null)
                        {
                            foreach (var item in ViewBag.SocialMedias)
                            {
                                <a href="@item.Url" target="_blank" rel="noopener noreferrer" class="social-pill" title="@item.Title">
                                    <i class="@item.IconUrl"></i>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- Right Column: Working Contact Form -->
            <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                <div class="bg-white p-4 p-md-5 rounded-4 border shadow-sm">
                    @if (TempData["MessageSent"] != null)
                    {
                        <div class="alert alert-success rounded-3 mb-4">
                            <i class="bi bi-check-circle-fill me-2"></i>@TempData["MessageSent"]
                        </div>
                    }

                    @if (TempData["MessageError"] != null)
                    {
                        <div class="alert alert-danger rounded-3 mb-4">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["MessageError"]
                        </div>
                    }

                    <form method="post" action="/Default/SendMessage">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Adınız Soyadınız *</label>
                                <input type="text" name="SenderName" maxlength="100" class="form-control form-control-custom" placeholder="Örn: Ahmet Yılmaz" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">E-posta Adresiniz *</label>
                                <input type="email" name="SenderEmail" maxlength="150" class="form-control form-control-custom" placeholder="ad@ornek.com" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Konu *</label>
                                <input type="text" name="Subject" maxlength="200" class="form-control form-control-custom" placeholder="Örn: Kurumsal .NET Eğitimi veya Danışmanlık" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Mesajınız *</label>
                                <textarea name="MessageDetail" maxlength="2000" class="form-control form-control-custom" rows="5" placeholder="Projeniz veya sorunuz hakkında detayları paylaşın..." required></textarea>
                            </div>
                            <div class="col-12 pt-2">
                                <button type="submit" class="btn-sage w-100 justify-content-center py-3 fs-6">
                                    <i class="bi bi-send-fill"></i>
                                    <span>Mesajımı Gönder</span>
                                </button>
                                <div class="text-muted text-center small mt-3" style="font-size: 0.78rem;">
                                    <i class="bi bi-shield-check me-1"></i> Gönderilen bilgiler gizlilik ilkeleri doğrultusunda korunmaktadır.
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
