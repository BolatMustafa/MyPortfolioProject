@model About

@if (Model != null)
{
    <section id="about" class="bg-white border-top border-bottom">
        <div class="container">
            <div class="row align-items-center gy-5">
                <!-- Left Column: Portrait and visual composition -->
                <div class="col-lg-5 reveal-on-scroll">
                    <div class="about-img-wrap overflow-hidden rounded-4 border shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.FullNameLocation"
                                 class="w-100 d-block"
                                 style="height: 380px; object-fit: cover; object-position: center 20%;"
                                 onerror="this.style.display='none'; document.getElementById('aboutImgFallback').style.display='flex';" />
                        }
                        <div id="aboutImgFallback" class="align-items-center justify-content-center flex-column text-muted bg-light"
                             style="height: 380px; display: @(string.IsNullOrWhiteSpace(Model.ImageUrl) ? "flex" : "none");">
                            <i class="bi bi-person-bounding-box" style="font-size: 4rem; color: #2f5d4e; opacity: 0.6;"></i>
                            <span class="small mt-2 fw-medium">@Model.FullNameLocation</span>
                        </div>
                        <div class="p-3 bg-light border-top d-flex align-items-center justify-content-between">
                            <span class="small text-muted font-heading">@Model.FullNameLocation</span>
                            <span class="badge bg-secondary-subtle text-dark fw-medium">@Model.Title</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Story & Stats -->
                <div class="col-lg-7 ps-lg-5 reveal-on-scroll">
                    <div class="eyebrow-badge">
                        <i class="bi bi-person-lines-fill"></i> BENİ TANIYIN
                    </div>
                    <h2 class="section-title">
                        @Model.Heading
                    </h2>
                    <div class="text-muted fs-5 mb-4 lh-base">
                        <p class="mb-3">@Model.Description1</p>
                        <p class="mb-4">@Model.Description2</p>
                    </div>

                    <!-- Statistics -->
                    <div class="row g-4 pt-2 pb-4 border-top border-bottom mb-4">
                        <div class="col-4">
                            <div class="stat-number">@Model.Stat1Number</div>
                            <div class="stat-label">@Model.Stat1Title</div>
                        </div>
                        <div class="col-4">
                            <div class="stat-number">@Model.Stat2Number</div>
                            <div class="stat-label">@Model.Stat2Title</div>
                        </div>
                        <div class="col-4">
                            <div class="stat-number">@Model.Stat3Number</div>
                            <div class="stat-label">@Model.Stat3Title</div>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.CvUrl) && Model.CvUrl != "#")
                        {
                            <a href="@Model.CvUrl" target="_blank" class="btn-sage">
                                <i class="bi bi-file-earmark-pdf"></i>
                                <span>Özgeçmişimi İncele</span>
                            </a>
                        }
                        else
                        {
                            <a href="#projects" class="btn-sage">
                                <i class="bi bi-folder2-open"></i>
                                <span>Projelerimi İncele</span>
                            </a>
                        }
                        <a href="#contact" class="btn-secondary-custom">
                            <span>Bana Ulaşın</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
